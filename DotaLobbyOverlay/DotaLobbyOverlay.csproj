<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DotaLobbyOverlay</AssemblyName>
    <RootNamespace>DotaLobbyOverlay</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="artifacts/NetHook2.dll" LogicalName="DotaLobbyOverlay.NetHook2.dll" Condition="Exists('artifacts/NetHook2.dll')" />
  </ItemGroup>
</Project>
